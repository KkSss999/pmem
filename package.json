{
  "name": "pmem-ai",
  "version": "1.3.5",
  "private": true,
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "better-sqlite3"
  ],
  "description": "Local infrastructure for a personal Memory and Knowledge SDK",
  "main": "dist/sdk/index.js",
  "types": "dist/sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "require": "./dist/sdk/index.js",
      "default": "./dist/sdk/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint .",
    "test": "node --test tests/*.test.cjs"
  },
  "license": "Apache-2.0",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KkSss999/pmem.git"
  },
  "engines": {
    "node": ">=22 <27"
  },
  "files": [
    "dist/sdk/index.js",
    "dist/sdk/index.d.ts",
    "dist/server/runtime.js",
    "dist/server/runtime.d.ts",
    "dist/db/database.js",
    "dist/db/database.d.ts",
    "dist/db/migrations.js",
    "dist/db/migrations.d.ts",
    "dist/db/schema.js",
    "dist/db/schema.d.ts",
    "migrations/**",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "drizzle-kit": "0.31.8",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "0.45.4"
  }
}
